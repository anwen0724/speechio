{
  "name": "realtime-asr-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "format": "prettier --write src public vite.config.ts index.html",
    "format:check": "prettier --check src public vite.config.ts index.html",
    "build": "npm run check && vite build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "playwright": "^1.64.0",
    "prettier": "^3.6.0",
    "typescript": "^7.0.0",
    "vite": "^8.3.4"
  }
}
