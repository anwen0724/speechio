include README.md pyproject.toml .python-version
recursive-include src *.py
recursive-include src/realtime_asr/assets *
recursive-include evals *.py *.mjs
recursive-include tests *.py *.mjs
recursive-include examples *.py
prune .runtime
prune .venv
prune artifacts
prune data
prune dist
prune build
prune .ruff_cache
global-exclude __pycache__ *.py[cod]
